        <record id="approval_document_type_sales_order" model="approval.document.type">
            <field name="name">Sales Order</field>
            <field name="document_nature">sales_order</field>
            <field name="module_code">sales_order</field>
            <field name="approval_module_code">sale</field>
            <field name="connector_module_name">custom_approval_sale</field>
            <field name="target_module_name">sale</field>
            <field name="amount_field_name">amount_total</field>
            <field name="partner_field_name">partner_id</field>
            <field name="date_field_name">date_order</field>
            <field name="document_number_field_name">name</field>
            <field name="company_id" eval="False"/>
            <field name="active">True</field>
        </record>

