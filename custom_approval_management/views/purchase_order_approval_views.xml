<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order Form - Add Approval Buttons and Section -->
    <record id="view_purchase_order_approval_form" model="ir.ui.view">
        <field name="name">purchase.order.form.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Inject approval buttons into the header -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                    name="action_submit_for_approval"
                    string="Submit for Approval"
                    type="object"
                    class="btn btn-primary"
                    invisible="state not in ['draft', 'sent'] or not approval_required or approval_state in ['waiting', 'partial', 'approved']"/>
            </xpath>

            <!-- Confirm (highlight) button: only for draft RFQ and approved when approval is required -->
            <xpath expr="//button[@name='button_confirm' and contains(@class, 'oe_highlight')]" position="attributes">
                <attribute name="invisible">state != 'draft' or (approval_required and approval_state != 'approved')</attribute>
            </xpath>

            <!-- Confirm (normal) button: only for sent RFQ and approved when approval is required -->
            <xpath expr="//button[@name='button_confirm' and not(contains(@class, 'oe_highlight'))]" position="attributes">
                <attribute name="invisible">state != 'sent' or (approval_required and approval_state != 'approved')</attribute>
            </xpath>

            <!-- Inject hidden technical fields and approval page into the sheet -->
            <xpath expr="//sheet/div[contains(@class, 'oe_button_box')]" position="before">
                <!-- Hidden fields required by button modifiers above -->
                <field name="approval_required" invisible="1"/>
                <field name="approval_state" invisible="1"/>
                <field name="approval_request_id" invisible="1"/>
                <field name="current_approval_level_id" invisible="1"/>
            </xpath>

            <!-- Smart button to open linked approval request -->
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_approval_request"
                    class="oe_stat_button"
                    icon="fa-check-square-o"
                    invisible="not approval_request_id">
                    <field name="approval_history_count" widget="statinfo" string="Approval"/>
                </button>
            </xpath>

            <!-- Main approval status panel as full-width banner -->
            <xpath expr="//sheet/div[contains(@class, 'oe_title')]" position="after">
                <div class="alert alert-warning" invisible="not approval_required or approval_state != 'waiting'">
                    <h4>Waiting for Approval</h4>
                    <p>This Purchase Order is waiting for approval.</p>
                    <group>
                        <group>
                            <field name="current_approval_level_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-info" invisible="not approval_required or approval_state != 'partial'">
                    <h4>Partially Approved</h4>
                    <p>This Purchase Order is partially approved and waiting for the next approval level.</p>
                    <group>
                        <group>
                            <field name="current_approval_level_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-success" invisible="not approval_required or approval_state != 'approved' or state not in ['draft', 'sent']">
                    <h4>Approved</h4>
                    <p>This Purchase Order has been fully approved and is ready for confirmation.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-success" invisible="not approval_required or approval_state != 'approved' or state not in ['purchase', 'done']">
                    <h4>Approval Completed</h4>
                    <p>This Purchase Order has been approved and confirmed.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-danger" invisible="not approval_required or approval_state != 'rejected'">
                    <h4>Rejected</h4>
                    <p>This Purchase Order approval request has been rejected.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="mt-2" invisible="not approval_request_id">
                    <button
                        name="action_view_approval_request"
                        type="object"
                        string="View Approval Request"
                        class="btn btn-secondary btn-sm"/>
                </div>
            </xpath>

            <!-- Add Approval Status page inside the existing notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Approval Status" name="approval_status">
                    <group string="Approval Status" invisible="not approval_required">
                        <group>
                            <field name="approval_required" readonly="1"/>
                            <field name="approval_state" readonly="1" widget="badge"
                                decoration-success="approval_state == 'approved'"
                                decoration-danger="approval_state == 'rejected'"
                                decoration-warning="approval_state in ['waiting', 'partial']"/>
                        </group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                            <field name="current_approval_level_id" readonly="1"/>
                            <field name="approval_history_count" readonly="1"/>
                        </group>
                    </group>
                    <p invisible="approval_required">
                        No approval configuration found for this Purchase Order.
                        Configure an Approval Document Type for purchase.order in Approval Management.
                    </p>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Purchase Order Search - Add Approval Filters -->
    <record id="view_purchase_order_approval_search" model="ir.ui.view">
        <field name="name">purchase.order.search.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/separator[1]" position="before">
                <separator/>
                <filter name="approval_pending" string="Approval Pending"
                    domain="[('approval_state', 'in', ['waiting', 'partial'])]"/>
                <filter name="approval_approved" string="Approval Approved"
                    domain="[('approval_state', '=', 'approved')]"/>
                <filter name="approval_rejected" string="Approval Rejected"
                    domain="[('approval_state', '=', 'rejected')]"/>
                <filter name="group_approval_state" string="Approval State"
                    context="{'group_by': 'approval_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Tree - Show Approval Status column -->
    <record id="view_purchase_order_approval_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="approval_required" invisible="1"/>
                <field name="approval_state"
                    widget="badge"
                    decoration-warning="approval_state in ['waiting', 'partial']"
                    decoration-success="approval_state == 'approved'"
                    decoration-danger="approval_state == 'rejected'"
                    invisible="not approval_required"/>
            </xpath>
        </field>
    </record>
</odoo>