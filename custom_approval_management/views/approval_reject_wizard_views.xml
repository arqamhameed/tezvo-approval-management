<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Reject Wizard Form View -->
    <record id="view_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">approval.reject.wizard.form</field>
        <field name="model">approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval Request">
                <sheet>
                    <group>
                        <field name="approval_request_id" readonly="1"/>
                        <field name="reason"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn btn-danger"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
