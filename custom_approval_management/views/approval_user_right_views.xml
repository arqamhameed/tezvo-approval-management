<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval User Right List View -->
    <record id="view_approval_user_right_tree" model="ir.ui.view">
        <field name="name">approval.user.right.tree</field>
        <field name="model">approval.user.right</field>
        <field name="arch" type="xml">
            <list string="User Approval Rights" decoration-warning="expiry_date and expiry_date &lt; current_date" decoration-muted="not active" create="0" delete="0">
                <field name="user_id"/>
                <field name="document_type_id"/>
                <field name="level_id"/>
                <field name="value_lower_limit"/>
                <field name="value_upper_limit"/>
                <field name="expiry_date"/>
                <field name="company_id"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Approval User Right Form View -->
    <record id="view_approval_user_right_form" model="ir.ui.view">
        <field name="name">approval.user.right.form</field>
        <field name="model">approval.user.right</field>
        <field name="arch" type="xml">
            <form string="User Approval Right" create="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="user_id"/>
                        </h1>
                    </div>
                    
                    <group string="User">
                        <field name="user_id"/>
                        <field name="company_id"/>
                    </group>
                    
                    <group string="Approval Scope">
                        <field name="document_type_id"/>
                        <field name="level_id"/>
                    </group>
                    
                    <group string="Value Limits">
                        <field name="value_lower_limit"/>
                        <field name="value_upper_limit"/>
                    </group>
                    
                    <group string="Validity &amp; Permissions">
                        <field name="expiry_date"/>
                        <field name="mandatory" widget="boolean"/>
                        <field name="document_read" widget="boolean"/>
                        <field name="active" widget="boolean"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Approval User Right Search View -->
    <record id="view_approval_user_right_search" model="ir.ui.view">
        <field name="name">approval.user.right.search</field>
        <field name="model">approval.user.right</field>
        <field name="arch" type="xml">
            <search string="User Approval Rights">
                <field name="user_id"/>
                <field name="document_type_id"/>
                <field name="level_id"/>
                <field name="company_id"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <filter name="expired" string="Expired" domain="[('expiry_date', '!=', False), ('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="filter_doctype" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                <filter name="filter_level" string="Approval Level" context="{'group_by': 'level_id'}"/>
                <filter name="filter_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- Approval User Right Action -->
    <record id="action_approval_user_right" model="ir.actions.act_window">
        <field name="name">Approval Users</field>
        <field name="res_model">approval.user.right</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_approval_user_right_search"/>
    </record>
</odoo>
