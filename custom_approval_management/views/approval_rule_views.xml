<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Rule List View -->
    <record id="view_approval_rule_tree" model="ir.ui.view">
        <field name="name">approval.rule.tree</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <list string="Approval Rules" decoration-muted="not active" create="0" delete="0">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="min_amount" sum="Min Amount"/>
                <field name="max_amount" sum="Max Amount"/>
                <field name="company_id"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Approval Rule Form View -->
    <record id="view_approval_rule_form" model="ir.ui.view">
        <field name="name">approval.rule.form</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Rule" create="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    
                    <group string="Rule Header">
                        <field name="document_type_id"/>
                        <field name="company_id"/>
                    </group>
                    
                    <group string="Amount Range">
                        <field name="min_amount"/>
                        <field name="max_amount"/>
                    </group>
                    
                    <group>
                        <field name="active"/>
                    </group>
                    
                    <notebook>
                        <page string="Approval Levels">
                            <field name="rule_line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="level_id"/>
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                    <field name="minimum_user_count"/>
                                    <field name="mandatory" widget="boolean"/>
                                    <field name="notification_event_ids" widget="many2many_tags"/>
                                    <field name="value_lower_limit"/>
                                    <field name="value_upper_limit"/>
                                    <field name="allow_same_user" widget="boolean"/>
                                    <field name="active" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Approval Rule Search View -->
    <record id="view_approval_rule_search" model="ir.ui.view">
        <field name="name">approval.rule.search</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <search string="Approval Rules">
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="company_id"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="filter_doctype" string="Document Type" context="{'group_by': 'document_type_id'}"/>
            </search>
        </field>
    </record>

    <!-- Approval Rule Action -->
    <record id="action_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">approval.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_approval_rule_search"/>
    </record>
</odoo>
