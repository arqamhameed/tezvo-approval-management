<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Document Type List View -->
    <record id="view_approval_document_type_tree" model="ir.ui.view">
        <field name="name">approval.document.type.tree</field>
        <field name="model">approval.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Types" decoration-muted="not active" create="0" delete="0">
                <field name="name"/>
                <field name="document_nature"/>
                <field name="model_name"/>
                <field name="company_id"/>
                <field name="active" widget="boolean"/>
            </list>
        </field>
    </record>

    <!-- Approval Document Type Form View -->
    <record id="view_approval_document_type_form" model="ir.ui.view">
        <field name="name">approval.document.type.form</field>
        <field name="model">approval.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type" create="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group string="Document Configuration">
                        <p class="text-muted" colspan="2">
                            Each document type can be configured only once per company.
                        </p>
                        <group>
                            <field name="document_nature"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="allow_cancel_approved_document"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Technical Configuration">
                        <p class="text-muted" colspan="2"
                           invisible="document_nature == 'custom'">
                            These fields are managed automatically based on the selected Document Type.
                            Switch to Custom / Advanced to edit them manually.
                        </p>
                        <group>
                            <field name="model_id" readonly="document_nature != 'custom'"/>
                            <field name="model_name" readonly="1"/>
                            <field name="module_code" readonly="document_nature != 'custom'"/>
                            <field name="approval_module_code" readonly="1"/>
                            <field name="connector_module_name" readonly="1"/>
                            <field name="target_module_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="document_filter_domain"
                                   widget="char"
                                   readonly="document_nature != 'custom'"
                                   placeholder="e.g., [('move_type', '=', 'in_invoice')]"/>
                        </group>
                    </group>

                    <group string="Field Mappings">
                        <p class="text-muted" colspan="2"
                           invisible="document_nature == 'custom'">
                            Field mappings are set automatically based on the selected Document Type.
                        </p>
                        <group>
                            <field name="amount_field_name"
                                   readonly="document_nature != 'custom'"
                                   placeholder="e.g., amount_total"/>
                            <field name="partner_field_name"
                                   readonly="document_nature != 'custom'"
                                   placeholder="e.g., partner_id"/>
                        </group>
                        <group>
                            <field name="date_field_name"
                                   readonly="document_nature != 'custom'"
                                   placeholder="e.g., date_order"/>
                            <field name="document_number_field_name"
                                   readonly="document_nature != 'custom'"
                                   placeholder="e.g., name"/>
                        </group>
                    </group>

                    <group string="Notification Settings">
                        <group>
                            <field name="notify_on_submit"/>
                            <field name="notify_on_next_level"/>
                            <field name="notify_on_final_approval"/>
                        </group>
                        <group>
                            <field name="notify_on_rejection"/>
                            <field name="notify_on_cancellation"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Approval Document Type Search View -->
    <record id="view_approval_document_type_search" model="ir.ui.view">
        <field name="name">approval.document.type.search</field>
        <field name="model">approval.document.type</field>
        <field name="arch" type="xml">
            <search string="Document Types">
                <field name="name"/>
                <field name="document_nature"/>
                <field name="model_name"/>
                <field name="company_id"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="filter_nature" string="Document Type" context="{'group_by': 'document_nature'}"/>
            </search>
        </field>
    </record>

    <!-- Approval Document Type Action -->
    <record id="action_approval_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">approval.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_approval_document_type_search"/>
    </record>
</odoo>

