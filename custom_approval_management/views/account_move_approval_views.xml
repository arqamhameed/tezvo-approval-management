                        </group>
                    </group>
                </div>

                <div class="alert alert-success" invisible="move_type != 'out_refund' or not approval_required or approval_state != 'approved' or state != 'draft'">
                    <h4>Approved</h4>
                    <p>This Customer Credit Note has been fully approved and is ready to post.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-success" invisible="move_type != 'out_refund' or not approval_required or approval_state != 'approved' or state != 'posted'">
                    <h4>Approval Completed</h4>
                    <p>This Customer Credit Note has been approved and posted.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-danger" invisible="move_type != 'out_refund' or not approval_required or approval_state != 'rejected'">
                    <h4>Rejected</h4>
                    <p>This Customer Credit Note approval request has been rejected.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-secondary" invisible="move_type != 'out_refund' or not approval_required or approval_state != 'cancelled'">
                    <h4>Approval Cancelled</h4>
                    <p>This Customer Credit Note approval request has been cancelled.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-warning" invisible="move_type != 'entry' or not approval_required or approval_state != 'waiting'">
                    <h4>Waiting for Approval</h4>
                    <p>This Journal Entry is waiting for approval.</p>
                    <group>
                        <group>
                            <field name="current_approval_level_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-info" invisible="move_type != 'entry' or not approval_required or approval_state != 'partial'">
                    <h4>Partially Approved</h4>
                    <p>This Journal Entry is partially approved and waiting for the next approval level.</p>
                    <group>
                        <group>
                            <field name="current_approval_level_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-success" invisible="move_type != 'entry' or not approval_required or approval_state != 'approved' or state != 'draft'">
                    <h4>Approved</h4>
                    <p>This Journal Entry has been fully approved and is ready to post.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-success" invisible="move_type != 'entry' or not approval_required or approval_state != 'approved' or state != 'posted'">
                    <h4>Approval Completed</h4>
                    <p>This Journal Entry has been approved and posted.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-danger" invisible="move_type != 'entry' or not approval_required or approval_state != 'rejected'">
                    <h4>Rejected</h4>
                    <p>This Journal Entry approval request has been rejected.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="alert alert-secondary" invisible="move_type != 'entry' or not approval_required or approval_state != 'cancelled'">
                    <h4>Approval Cancelled</h4>
                    <p>This Journal Entry approval request has been cancelled.</p>
                    <group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                        </group>
                    </group>
                </div>

                <div class="mt-2" invisible="not approval_request_id">
                    <button
                        name="action_view_approval_request"
                        type="object"
                        string="View Approval Request"
                        class="btn btn-secondary btn-sm"/>
                </div>
            </xpath>

            <!-- Approval Status page -->
            <xpath expr="//notebook" position="inside">
                <page string="Approval Status" name="approval_status" invisible="move_type not in ['in_invoice', 'in_refund', 'out_invoice', 'out_refund', 'entry']">
                    <group string="Approval Status" invisible="not approval_required">
                        <group>
                            <field name="approval_required" readonly="1"/>
                            <field name="approval_state" readonly="1" widget="badge"
                                decoration-success="approval_state == 'approved'"
                                decoration-danger="approval_state == 'rejected'"
                                decoration-warning="approval_state in ['waiting', 'partial']"
                                decoration-muted="approval_state == 'cancelled'"/>
                        </group>
                        <group>
                            <field name="approval_request_id" readonly="1"/>
                            <field name="current_approval_level_id" readonly="1"/>
                            <field name="approval_history_count" readonly="1"/>
                        </group>
                    </group>
                    <p invisible="approval_required">
                        No approval configuration found for this document.
                        Configure an Approval Document Type for account.move in Approval Management.
                    </p>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
