<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approval Request List View -->
    <record id="view_approval_request_tree" model="ir.ui.view">
        <field name="name">approval.request.tree</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" create="0" delete="0" duplicate="0" decoration-warning="state in ['waiting','partial']" decoration-success="state=='approved'" decoration-danger="state=='rejected'" decoration-muted="state in ['draft','cancelled']">
                <field name="cycle_no"/>
                <field name="name"/>
                <field name="document_type_id"/>
                <field name="document_ref"/>
                <field name="amount_total" sum="Total Amount"/>
                <field name="submitted_by"/>
                <field name="submitted_date"/>
                <field name="state" widget="badge" decoration-success="state=='approved'" decoration-danger="state=='rejected'" decoration-warning="state in ['waiting','partial']" decoration-info="state=='partial'"/>
            </list>
        </field>
    </record>

    <!-- My Pending Approvals List View -->
    <record id="view_approval_request_my_pending_tree" model="ir.ui.view">
        <field name="name">approval.request.my.pending.tree</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <list string="My Pending Approvals" create="0" delete="0" duplicate="0" decoration-warning="state in ['waiting','partial']" decoration-success="state=='approved'" decoration-danger="state=='rejected'">
                <header>
                    <button name="action_refresh_my_pending_approvals" string="Refresh" type="object" class="btn-secondary" display="always"/>
                </header>
                <field name="document_type_id"/>
                <field name="document_ref"/>
                <field name="partner_id"/>
                <field name="amount_total" sum="Total Amount"/>
                <field name="submitted_by"/>
                <field name="submitted_date"/>
                <field name="current_level_id"/>
                <field name="state" widget="badge" decoration-success="state=='approved'" decoration-danger="state=='rejected'" decoration-warning="state in ['waiting','partial']"/>
            </list>
        </field>
    </record>

    <!-- Approval Request Form View -->
    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">approval.request.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request" create="0" delete="0" duplicate="0" class="o_custom_approval_request_form">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state not in ['waiting', 'partial'] or not can_current_user_approve"/>
                    <button name="action_open_reject_wizard" string="Reject" type="object" class="btn-danger" invisible="state not in ['waiting', 'partial'] or not can_current_user_reject"/>
                    <button name="action_open_document" string="Open Document" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel Request" type="object" class="btn-warning" invisible="state not in ['draft', 'waiting', 'partial']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting,partial,approved,rejected,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- Hidden fields required for modifiers in header buttons -->
                    <field name="can_current_user_approve" invisible="1"/>
                    <field name="can_current_user_reject" invisible="1"/>

                    <div class="alert alert-warning rounded border mb-3" role="status" invisible="state != 'waiting'">
                        <strong>Waiting Approval:</strong>
                        This approval request is waiting for the current approval level.
                    </div>
                    <div class="alert alert-info rounded border mb-3" role="status" invisible="state != 'partial'">
                        <strong>Partially Approved:</strong>
                        This approval request is partially approved and waiting for the next approval level.
                    </div>
                    <div class="alert alert-success rounded border mb-3" role="status" invisible="state != 'approved'">
                        <strong>Approved:</strong>
                        This approval request has been fully approved.
                    </div>
                    <div class="alert alert-danger rounded border mb-3" role="status" invisible="state != 'rejected'">
                        <strong>Rejected:</strong>
                        This approval request has been rejected.
                    </div>
                    <div class="alert alert-secondary rounded border mb-3" role="status" invisible="state != 'cancelled'">
                        <strong>Cancelled:</strong>
                        This approval request has been cancelled.
                    </div>
                    
                    <!-- Main Information Section -->
                    <div class="o_horizontal_separator text-muted">Document Information</div>
                    <group class="bg-light rounded border p-3">
                        <group string="Document Summary">
                            <field name="document_type_id" readonly="1"/>
                            <field name="document_ref" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                        </group>
                        <group string="Approval Context">
                            <field name="company_id" readonly="1"/>
                            <field name="current_level_id" readonly="1"/>
                            <field name="cycle_no" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Submission Details Section -->
                    <div class="o_horizontal_separator text-muted">Submission Details</div>
                    <group class="rounded border p-3">
                        <group>
                            <field name="submitted_by" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Notebook Tabs -->
                    <notebook>
                        <page string="Approval Levels">
                            <field name="request_line_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="level_id"/>
                                    <field name="minimum_user_count"/>
                                    <field name="allowed_approver_names" string="Allowed Approvers"/>
                                    <field name="approved_user_ids" widget="many2many_tags"/>
                                    <field name="state" widget="badge" decoration-success="state=='approved'" decoration-danger="state=='rejected'" decoration-warning="state=='pending'" decoration-muted="state in ['skipped','cancelled']" decoration-info="state=='skipped'"/>
                                    <field name="approved_date"/>
                                    <field name="allow_same_user"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval History">
                            <field name="history_ids" readonly="1">
                                <list>
                                    <field name="action_date"/>
                                    <field name="user_id"/>
                                    <field name="action" widget="badge" decoration-success="action=='approved'" decoration-danger="action=='rejected'" decoration-info="action=='submitted'" decoration-warning="action=='reset'" decoration-muted="action=='cancelled'"/>
                                    <field name="level_id"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Approval Request Search View -->
    <record id="view_approval_request_search" model="ir.ui.view">
        <field name="name">approval.request.search</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <search string="Approval Requests">
                <field name="name" string="Request / Document Ref"/>
                <field name="document_type_id"/>
                <field name="document_ref"/>
                <field name="submitted_by"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="waiting" string="Waiting Approval" domain="[('state', '=', 'waiting')]"/>
                <filter name="partial" string="Partially Approved" domain="[('state', '=', 'partial')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="my_pending" string="My Pending Approvals" domain="[('can_current_user_approve', '=', True)]"/>
                <filter name="my_submitted" string="My Submitted" domain="[('submitted_by', '=', uid)]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_company" string="Company" context="{'group_by': 'company_id'}"/>
                <filter name="filter_status" string="Status" context="{'group_by': 'state'}"/>
                <filter name="filter_document_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                <filter name="filter_level" string="Current Level" context="{'group_by': 'current_level_id'}"/>
                <filter name="filter_submitted_by" string="Submitted By" context="{'group_by': 'submitted_by'}"/>
            </search>
        </field>
    </record>

    <!-- Server action for My Pending Approvals (reliable Python-based ID resolution) -->
    <record id="action_my_pending_approvals_server" model="ir.actions.server">
        <field name="name">My Pending Approvals</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="state">code</field>
        <field name="code">action = model.action_my_pending_approvals()</field>
    </record>

    <!-- My Pending Approvals Action (kept for search-filter domain compatibility) -->
    <record id="action_approval_request_my_pending" model="ir.actions.act_window">
        <field name="name">My Pending Approvals</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('can_current_user_approve', '=', True)]</field>
        <field name="context">{'create': 0}</field>
        <field name="search_view_id" ref="view_approval_request_search"/>
    </record>

    <!-- All Approval Requests Action -->
    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">All Approval Requests</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': 0}</field>
        <field name="search_view_id" ref="view_approval_request_search"/>
    </record>
</odoo>
